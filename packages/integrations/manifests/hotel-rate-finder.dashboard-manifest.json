{
  "id": "hotel-rate-finder",
  "name": "Hotel Rate Finder",
  "version": "dashboard-app.v1",
  "baseUrlEnv": "HOTEL_RATE_FINDER_API_BASE_URL",
  "healthUrl": "/api/providers",
  "panels": [
    {
      "id": "hotel-watches",
      "type": "watch-table",
      "title": "Hotel Rate Watches",
      "dataSource": "/api/apps/hotel-rate-finder/items?type=rate-watch",
      "defaultPosition": "travel"
    },
    {
      "id": "hotel-status",
      "type": "status",
      "title": "Hotel Rate Finder",
      "dataSource": "/api/apps/hotel-rate-finder/items?type=status",
      "defaultPosition": "operations"
    }
  ],
  "capabilities": [
    {
      "id": "hotel_search",
      "title": "Search hotel availability",
      "kind": "deterministic",
      "target": "hotel-rate-finder",
      "endpoint": "/api/integrations/hotel-rate-finder/searches",
      "description": "Start a typed Hyatt or IHG availability and rate search without booking.",
      "inputSchema": {
        "providers": "hyatt|ihg[]?",
        "mode": "region|hotel|url",
        "area": "string?",
        "hotelId": "string?",
        "url": "string?",
        "checkIn": "YYYY-MM-DD",
        "checkOut": "YYYY-MM-DD",
        "rooms": "positive integer?",
        "adults": "positive integer?",
        "kids": "non-negative integer?",
        "displayCurrency": "ISO 4217?",
        "excludeResortFees": "boolean?",
        "forceRefresh": "boolean?"
      }
    },
    {
      "id": "hotel_search_status",
      "title": "Check hotel search",
      "kind": "deterministic",
      "target": "hotel-rate-finder",
      "endpoint": "/api/integrations/hotel-rate-finder/status",
      "description": "Read one hotel availability search and its results.",
      "inputSchema": {
        "jobId": "string"
      }
    },
    {
      "id": "hotel_search_cancel",
      "title": "Cancel hotel search",
      "kind": "deterministic",
      "target": "hotel-rate-finder",
      "endpoint": "/api/integrations/hotel-rate-finder/cancel",
      "description": "Cancel a queued or running hotel availability search.",
      "inputSchema": {
        "jobId": "string"
      }
    },
    {
      "id": "hotel_rate_search",
      "title": "Search hotel rates",
      "kind": "deterministic",
      "target": "hotel-rate-finder",
      "endpoint": "/api/integrations/hotel-rate-finder/sync",
      "description": "Refresh Hotel Rate Finder saved searches for active refundable hotel reservations.",
      "inputSchema": {
        "reservationId": "string?",
        "forceRefresh": "boolean?"
      }
    },
    {
      "id": "evaluate_rebook",
      "title": "Evaluate hotel rebook",
      "kind": "agentic",
      "target": "hotel-rate-finder",
      "description": "Ask Hermes to reason over rate evidence, cancellation policy, and points alternatives before recommending rebook or wait.",
      "inputSchema": {
        "reservationId": "string",
        "watchId": "string"
      }
    }
  ],
  "eventTypes": ["reservation", "rate-watch", "status"],
  "deepLink": "/"
}
