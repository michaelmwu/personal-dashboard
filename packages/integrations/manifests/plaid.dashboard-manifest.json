{
  "id": "plaid",
  "name": "Plaid",
  "version": "dashboard-app.v1",
  "baseUrl": "external:plaid",
  "panels": [
    {
      "id": "plaid-sync",
      "type": "status",
      "title": "Plaid Sync",
      "dataSource": "/api/apps/plaid/items?type=sync",
      "defaultPosition": "finance"
    }
  ],
  "capabilities": [
    {
      "id": "finance_overview",
      "title": "Review finance overview",
      "kind": "deterministic",
      "target": "finance-dashboard",
      "endpoint": "/api/hermes/finance/overview",
      "description": "Read a bounded account, fee, benefit, and recent-credit overview for the selected period.",
      "inputSchema": {
        "accountType": "credit|depository?",
        "startDate": "YYYY-MM-DD?",
        "endDate": "YYYY-MM-DD?"
      }
    },
    {
      "id": "plaid_sync",
      "title": "Sync Plaid transactions",
      "kind": "deterministic",
      "target": "plaid",
      "endpoint": "/api/integrations/plaid/sync",
      "description": "Pull latest card transactions and queue reconciliation work.",
      "inputSchema": {
        "itemId": "string?"
      }
    }
  ],
  "eventTypes": ["account", "transaction", "sync"]
}
